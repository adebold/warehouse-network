{
  "name": "api-management-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade API management and integration platform",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run build:gateway && npm run build:docs",
    "build:gateway": "webpack --mode=production",
    "build:docs": "node scripts/generate-docs.js",
    "generate:sdk": "node scripts/generate-sdk.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t api-platform .",
    "docker:run": "docker run -p 8000:8000 api-platform",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "apollo-server-express": "^3.12.1",
    "graphql": "^16.8.1",
    "mongoose": "^7.6.3",
    "redis": "^4.6.8",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.6.0",
    "passport-oauth2": "^1.7.0",
    "passport-jwt": "^4.0.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "axios": "^1.5.0",
    "bull": "^4.11.4",
    "node-cron": "^3.0.2",
    "winston": "^3.10.0",
    "dotenv": "^17.3.1",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "joi": "^17.11.0",
    "multer": "^1.4.5-lts.1",
    "semver": "^7.5.4",
    "handlebars": "^4.7.8",
    "openapi-generator-cli": "^2.7.0",
    "express-prometheus-middleware": "^1.2.0",
    "prom-client": "^14.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "api",
    "management",
    "gateway",
    "graphql",
    "webhooks",
    "integration",
    "enterprise"
  ],
  "author": "API Management Team",
  "license": "MIT"
}