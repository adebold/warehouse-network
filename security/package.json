{
  "name": "@warehouse-network/security",
  "version": "1.0.0",
  "description": "Enterprise security credential management system for GCP deployment",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:security": "jest --testPathPattern=security",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ tests/",
    "audit": "npm audit && node src/audit/security-scan.js",
    "rotate": "node src/rotation/rotate-credentials.js",
    "validate": "node src/validation/validate-standards.js"
  },
  "dependencies": {
    "@google-cloud/logging": "^10.5.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "argon2": "^0.31.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "security",
    "credentials",
    "encryption",
    "gcp",
    "secret-manager",
    "enterprise"
  ]
}
