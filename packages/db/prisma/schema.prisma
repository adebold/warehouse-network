// Prisma Schema for Skidspace.com Multi-Tenant Authentication & SaaS Platform
// Generated by Swarm Coordination Team - 2026-03-23

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ORGANIZATIONS & TENANT MANAGEMENT
// =============================================================================

model Organization {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String    @unique
  domain             String?
  logoUrl            String?   @map("logo_url")

  // Tenant configuration
  planType           String    @default("basic") @map("plan_type")
  status             String    @default("active")
  settings           Json      @default("{}")
  features           Json      @default("[]")
  limits             Json      @default("{}")

  // Billing information
  billingEmail       String?   @map("billing_email")
  billingAddress     Json?     @map("billing_address")
  subscriptionId     String?   @map("subscription_id")
  subscriptionStatus String?   @map("subscription_status")
  trialEndsAt        DateTime? @map("trial_ends_at")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  users              User[]
  roles              Role[]
  personas           Persona[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  memberships        OrganizationMembership[]

  // Analytics relations
  warehouses         Warehouse[]
  bookings           Booking[]
  transactions       Transaction[]
  analyticsEvents    AnalyticsEvent[]
  userSessions       UserSession[]
  dailyMetrics       DailyMetrics[]
  customerJourneys   CustomerJourney[]
  alertRules         AlertRule[]
  alertNotifications AlertNotification[]
  inviteTokens       InviteToken[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  role           String    @default("member")
  status         String    @default("active")
  invitedBy      String?   @map("invited_by") @db.Uuid
  invitedAt      DateTime? @map("invited_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("UserInvitations", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

// =============================================================================
// USER MANAGEMENT & AUTHENTICATION (NextAuth.js Compatible)
// =============================================================================

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  // Extended fields for multi-tenant platform
  tenantId      String    @map("tenant_id") @db.Uuid
  status        String    @default("active")
  lastLogin     DateTime? @map("last_login")
  loginCount    Int       @default(0) @map("login_count")
  preferences   Json      @default("{}")
  metadata      Json      @default("{}")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  organization     Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts         Account[]
  sessions         Session[]
  roles            UserRole[]
  personas         UserPersona[]
  sessionContexts  UserSessionContext[]
  auditLogs        AuditLog[]
  securityEvents   SecurityEvent[]
  memberships      OrganizationMembership[]
  invitations      OrganizationMembership[] @relation("UserInvitations")

  // Analytics relations
  bookings         Booking[]
  transactions     Transaction[]
  analyticsEvents  AnalyticsEvent[]
  userSessions     UserSession[]
  customerJourneys CustomerJourney[]
  alertNotifications AlertNotification[]
  apiKeys          ApiKey[]
  inviteTokensSent InviteToken[] @relation("UserInvites")
  inviteTokensAccepted InviteToken[] @relation("UserAccepts")

  @@map("users")
}

// NextAuth.js required tables
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// ROLE-BASED ACCESS CONTROL (RBAC)
// =============================================================================

model Role {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String? @map("tenant_id") @db.Uuid // NULL for global roles
  name         String
  displayName  String  @map("display_name")
  description  String?

  // Role hierarchy
  parentRoleId String? @map("parent_role_id") @db.Uuid
  level        Int     @default(0)

  // Role metadata
  isSystemRole Boolean @default(false) @map("is_system_role")
  isAssignable Boolean @default(true) @map("is_assignable")
  color        String?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRole   Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]           @relation("RoleHierarchy")
  permissions  RolePermission[]
  userRoles    UserRole[]
  personas     Persona[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String @unique
  displayName String @map("display_name")
  description String?
  category    String?

  // Permission metadata
  resourceType String? @map("resource_type")
  action       String?
  scope        String  @default("tenant") // global, tenant, resource

  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  granted      Boolean @default(true)
  conditions   Json?   // Additional conditions for the permission

  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid

  // Assignment metadata
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")
  conditions Json?     // Additional conditions for role assignment

  // Context information
  context    String?   // 'direct', 'inherited', 'temporary'
  resourceId String?   @map("resource_id") @db.Uuid // For resource-specific role assignments

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId, resourceId])
  @@map("user_roles")
}

// =============================================================================
// PERSONA MANAGEMENT SYSTEM
// =============================================================================

model Persona {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String? @map("tenant_id") @db.Uuid // NULL for global personas
  name                String
  displayName         String  @map("display_name")
  description         String?

  // Persona configuration
  defaultRoleId       String? @map("default_role_id") @db.Uuid
  uiConfig            Json    @default("{}") @map("ui_config")
  features            Json    @default("[]")
  permissionsOverride Json    @default("{}") @map("permissions_override")

  // Persona metadata
  color               String?
  icon                String?
  isSystemPersona     Boolean @default(false) @map("is_system_persona")
  isActive            Boolean @default(true) @map("is_active")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultRole     Role?                @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  userPersonas    UserPersona[]
  sessionContexts UserSessionContext[]

  @@unique([tenantId, name])
  @@map("personas")
}

model UserPersona {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  personaId  String  @map("persona_id") @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid

  // Assignment metadata
  isDefault  Boolean @default(false) @map("is_default")
  isActive   Boolean @default(true) @map("is_active")
  assignedBy String? @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona      Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, personaId, tenantId])
  @@map("user_personas")
}

model UserSessionContext {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken    String  @unique @map("session_token")
  userId          String  @map("user_id") @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  activePersonaId String? @map("active_persona_id") @db.Uuid

  // Context metadata
  ipAddress       String? @map("ip_address") @db.Inet
  userAgent       String? @map("user_agent") @db.Text

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activePersona   Persona?     @relation(fields: [activePersonaId], references: [id], onDelete: SetNull)

  @@map("user_session_contexts")
}

// =============================================================================
// AUDIT & SECURITY LOGGING
// =============================================================================

model AuditLog {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String? @map("tenant_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid
  sessionToken  String? @map("session_token")

  // Event details
  eventType     String  @map("event_type")
  eventCategory String  @map("event_category") // auth, rbac, data, system
  resourceType  String? @map("resource_type")
  resourceId    String? @map("resource_id")

  // Event data
  eventData     Json    @default("{}") @map("event_data")
  oldValues     Json?   @map("old_values")
  newValues     Json?   @map("new_values")

  // Request context
  ipAddress     String? @map("ip_address") @db.Inet
  userAgent     String? @map("user_agent") @db.Text
  requestId     String? @map("request_id")

  // Event metadata
  severity      String  @default("info") @map("severity") // debug, info, warn, error, critical
  status        String  @default("success") @map("status") // success, failure, pending

  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SecurityEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid

  // Event classification
  eventType   String    @map("event_type")
  severity    String    @map("severity") // low, medium, high, critical
  status      String    @default("detected") @map("status") // detected, investigating, resolved

  // Event details
  description String
  details     Json      @default("{}") @map("details")

  // Source information
  sourceIp    String?   @map("source_ip") @db.Inet
  userAgent   String?   @map("user_agent") @db.Text
  endpoint    String?   @map("endpoint")

  // Response information
  blocked     Boolean   @default(false)
  actionTaken String?   @map("action_taken")

  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  // Relations
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("security_events")
}

// =============================================================================
// ADDITIONAL UTILITY MODELS
// =============================================================================

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash") // Store hash, not actual key
  permissions Json      @default("[]")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model InviteToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String
  token          String    @unique
  roleIds        Json      @default("[]") @map("role_ids") // Array of role IDs to assign
  personaIds     Json      @default("[]") @map("persona_ids") // Array of persona IDs to assign
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  acceptedBy     String?   @map("accepted_by") @db.Uuid

  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter        User         @relation("UserInvites", fields: [invitedBy], references: [id], onDelete: Cascade)
  acceptor       User?        @relation("UserAccepts", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@map("invite_tokens")
}

// =============================================================================
// WAREHOUSE MARKETPLACE MODELS
// =============================================================================

model Warehouse {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  description        String?
  address            Json
  coordinates        String?   // POINT type for geographic coordinates
  totalCapacity      BigInt    @map("total_capacity")
  availableCapacity  BigInt    @map("available_capacity")
  pricePerSqFt       Decimal   @map("price_per_sq_ft") @db.Decimal(10,2)
  amenities          Json      @default("[]")
  operatingHours     Json      @default("{}") @map("operating_hours")
  contactInfo        Json      @default("{}") @map("contact_info")
  status             String    @default("active")
  verificationStatus String    @default("pending") @map("verification_status")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spaces             WarehouseSpace[]
  bookings           Booking[]
  analyticsEvents    AnalyticsEvent[]
  warehousePerformance WarehousePerformance[]

  @@map("warehouses")
}

model WarehouseSpace {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId          String    @map("warehouse_id") @db.Uuid
  name                 String
  description          String?
  spaceType            String    @map("space_type") // storage, office, loading_dock, etc
  dimensions           Json      // length, width, height
  capacity             BigInt
  pricePerSqFt         Decimal   @map("price_per_sq_ft") @db.Decimal(10,2)
  amenities            Json      @default("[]")
  isClimateControlled  Boolean   @default(false) @map("is_climate_controlled")
  isSecure             Boolean   @default(false) @map("is_secure")
  status               String    @default("available")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  warehouse            Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bookings             Booking[]

  @@map("warehouse_spaces")
}

model Booking {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  customerId            String    @map("customer_id") @db.Uuid
  warehouseId           String    @map("warehouse_id") @db.Uuid
  spaceId               String    @map("space_id") @db.Uuid

  // Booking details
  bookingType           String    @map("booking_type") // short_term, long_term, on_demand
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  durationDays          Int?      @map("duration_days")
  squareFootage         Decimal   @map("square_footage") @db.Decimal(10,2)

  // Pricing
  baseRate              Decimal   @map("base_rate") @db.Decimal(10,2)
  totalAmount           Decimal   @map("total_amount") @db.Decimal(10,2)
  currency              String    @default("USD")

  // Status
  status                String    @default("pending")
  paymentStatus         String    @default("pending") @map("payment_status")

  // Metadata
  specialRequirements   Json      @default("{}") @map("special_requirements")
  bookingMetadata       Json      @default("{}") @map("booking_metadata")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  organization          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  warehouse             Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  space                 WarehouseSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  analyticsEvents       AnalyticsEvent[]
  customerJourneys      CustomerJourney[]

  @@map("bookings")
}

model Transaction {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  bookingId              String?   @map("booking_id") @db.Uuid
  userId                 String?   @map("user_id") @db.Uuid

  // Transaction details
  transactionType        String    @map("transaction_type") // booking, refund, fee, commission
  amount                 Decimal   @db.Decimal(10,2)
  currency               String    @default("USD")
  status                 String

  // Payment processing
  paymentMethod          String?   @map("payment_method")
  paymentProcessor       String?   @map("payment_processor")
  externalTransactionId  String?   @map("external_transaction_id")
  processorFee           Decimal?  @map("processor_fee") @db.Decimal(10,2)
  platformFee            Decimal?  @map("platform_fee") @db.Decimal(10,2)

  // Metadata
  description            String?
  transactionMetadata    Json      @default("{}") @map("transaction_metadata")

  processedAt            DateTime? @map("processed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  // Relations
  organization           Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking                Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// =============================================================================
// ANALYTICS AND TRACKING MODELS
// =============================================================================

model AnalyticsEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  sessionId         String?   @map("session_id")

  // Event classification
  eventName         String    @map("event_name")
  eventCategory     String    @map("event_category") // user_action, system, business, error
  eventType         String    @map("event_type") // click, view, booking, search, etc

  // Event context
  pageUrl           String?   @map("page_url") @db.Text
  referrer          String?   @db.Text
  userAgent         String?   @map("user_agent") @db.Text
  ipAddress         String?   @map("ip_address")
  deviceType        String?   @map("device_type")
  browser           String?
  os                String?

  // Event data
  eventProperties   Json      @default("{}") @map("event_properties")
  customProperties  Json      @default("{}") @map("custom_properties")

  // Business context
  warehouseId       String?   @map("warehouse_id") @db.Uuid
  bookingId         String?   @map("booking_id") @db.Uuid

  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  organization      Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  warehouse         Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  booking           Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userSession       UserSession?  @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@map("analytics_events")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String    @unique @map("session_id")
  userId           String?   @map("user_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid

  // Session metadata
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent") @db.Text
  deviceType       String?   @map("device_type")
  browser          String?
  os               String?

  // Session tracking
  entryPage        String?   @map("entry_page") @db.Text
  exitPage         String?   @map("exit_page") @db.Text
  pageViews        Int       @default(0) @map("page_views")
  sessionDuration  Int?      @map("session_duration") // seconds
  isBounce         Boolean   @default(false) @map("is_bounce")
  conversionEvents Json      @default("[]") @map("conversion_events")

  // Geographic data
  country          String?
  region           String?
  city             String?

  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analyticsEvents  AnalyticsEvent[]
  customerJourneys CustomerJourney[]

  @@map("user_sessions")
}

model DailyMetrics {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  metricDate              DateTime  @map("metric_date") @db.Date

  // User metrics
  activeUsers             Int       @default(0) @map("active_users")
  newUsers                Int       @default(0) @map("new_users")
  returningUsers          Int       @default(0) @map("returning_users")
  totalSessions           Int       @default(0) @map("total_sessions")
  avgSessionDuration      Decimal   @default(0) @map("avg_session_duration") @db.Decimal(10,2)
  bounceRate              Decimal   @default(0) @map("bounce_rate") @db.Decimal(5,2)

  // Business metrics
  totalBookings           Int       @default(0) @map("total_bookings")
  successfulBookings      Int       @default(0) @map("successful_bookings")
  cancelledBookings       Int       @default(0) @map("cancelled_bookings")
  totalRevenue            Decimal   @default(0) @map("total_revenue") @db.Decimal(15,2)
  grossRevenue            Decimal   @default(0) @map("gross_revenue") @db.Decimal(15,2)
  netRevenue              Decimal   @default(0) @map("net_revenue") @db.Decimal(15,2)
  avgBookingValue         Decimal   @default(0) @map("avg_booking_value") @db.Decimal(10,2)

  // Warehouse metrics
  totalWarehouseViews     Int       @default(0) @map("total_warehouse_views")
  totalWarehouseInquiries Int       @default(0) @map("total_warehouse_inquiries")
  warehouseConversionRate Decimal   @default(0) @map("warehouse_conversion_rate") @db.Decimal(5,2)
  occupancyRate           Decimal   @default(0) @map("occupancy_rate") @db.Decimal(5,2)

  // Platform metrics
  platformFeeCollected    Decimal   @default(0) @map("platform_fee_collected") @db.Decimal(15,2)
  paymentProcessingFees   Decimal   @default(0) @map("payment_processing_fees") @db.Decimal(15,2)

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  organization            Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricDate])
  @@map("daily_metrics")
}

model WarehousePerformance {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId           String    @map("warehouse_id") @db.Uuid
  metricDate            DateTime  @map("metric_date") @db.Date

  // Performance metrics
  totalViews            Int       @default(0) @map("total_views")
  totalInquiries        Int       @default(0) @map("total_inquiries")
  totalBookings         Int       @default(0) @map("total_bookings")
  totalRevenue          Decimal   @default(0) @map("total_revenue") @db.Decimal(15,2)
  occupancyRate         Decimal   @default(0) @map("occupancy_rate") @db.Decimal(5,2)

  // Utilization metrics
  spaceUtilization      Decimal   @default(0) @map("space_utilization") @db.Decimal(5,2)
  avgBookingDuration    Decimal   @default(0) @map("avg_booking_duration") @db.Decimal(10,2)
  bookingConversionRate Decimal   @default(0) @map("booking_conversion_rate") @db.Decimal(5,2)

  // Customer satisfaction
  avgRating             Decimal?  @map("avg_rating") @db.Decimal(3,2)
  totalReviews          Int       @default(0) @map("total_reviews")

  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, metricDate])
  @@map("warehouse_performance")
}

model CustomerJourney {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  sessionId           String?   @map("session_id")

  // Journey tracking
  touchpoints         Json      @default("[]") // Array of touchpoint objects
  conversionEvents    Json      @default("[]") @map("conversion_events")
  journeyStage        String?   @map("journey_stage") // awareness, consideration, intent, purchase, retention

  // Journey metrics
  totalTouchpoints    Int       @default(0) @map("total_touchpoints")
  journeyDuration     Int?      @map("journey_duration") // seconds from first to last touchpoint
  converted           Boolean   @default(false)
  conversionValue     Decimal?  @map("conversion_value") @db.Decimal(10,2)

  // Attribution
  firstTouchChannel   String?   @map("first_touch_channel")
  lastTouchChannel    String?   @map("last_touch_channel")
  attributionModel    String    @default("last_click") @map("attribution_model")

  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Relations
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userSession         UserSession?  @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)
  booking             Booking?      @relation(fields: [userId], references: [customerId], onDelete: SetNull)

  @@map("customer_journeys")
}

// =============================================================================
// ALERTS AND MONITORING
// =============================================================================

model AlertRule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid

  // Rule definition
  ruleName            String    @map("rule_name")
  description         String?
  metricName          String    @map("metric_name")
  conditionType       String    @map("condition_type") // greater_than, less_than, equals, change_rate
  thresholdValue      Decimal   @map("threshold_value") @db.Decimal(15,2)
  comparisonPeriod    String?   @map("comparison_period") // hour, day, week, month

  // Alert configuration
  severity            String    @default("medium") // low, medium, high, critical
  isActive            Boolean   @default(true) @map("is_active")
  notificationChannels Json     @default("[]") @map("notification_channels") // email, sms, slack, webhook

  // Execution settings
  evaluationFrequency String    @default("hourly") @map("evaluation_frequency") // minutely, hourly, daily
  suppressDuration    Int       @default(3600) @map("suppress_duration") // seconds to suppress repeat alerts

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  organization        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications       AlertNotification[]

  @@map("alert_rules")
}

model AlertNotification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  alertRuleId         String    @map("alert_rule_id") @db.Uuid

  // Alert details
  alertLevel          String    @map("alert_level")
  message             String    @db.Text
  metricValue         Decimal?  @map("metric_value") @db.Decimal(15,2)
  thresholdValue      Decimal?  @map("threshold_value") @db.Decimal(15,2)

  // Notification tracking
  notificationChannels Json     @default("[]") @map("notification_channels")
  deliveryStatus      Json      @default("{}") @map("delivery_status") // Channel-specific delivery status
  acknowledged        Boolean   @default(false)
  acknowledgedBy      String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt      DateTime? @map("acknowledged_at")

  // Resolution tracking
  resolved            Boolean   @default(false)
  resolvedAt          DateTime? @map("resolved_at")
  resolutionNotes     String?   @map("resolution_notes") @db.Text

  triggeredAt         DateTime  @default(now()) @map("triggered_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Relations
  organization        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alertRule           AlertRule    @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  acknowledgedByUser  User?        @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@map("alert_notifications")
}

model SystemPerformance {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // System metrics
  metricTimestamp       DateTime  @default(now()) @map("metric_timestamp")
  cpuUsage              Decimal?  @map("cpu_usage") @db.Decimal(5,2)
  memoryUsage           Decimal?  @map("memory_usage") @db.Decimal(5,2)
  diskUsage             Decimal?  @map("disk_usage") @db.Decimal(5,2)
  networkIo             Json      @default("{}") @map("network_io")

  // Database performance
  dbConnections         Int?      @map("db_connections")
  dbSlowQueries         Int?      @map("db_slow_queries")
  dbAvgResponseTime     Decimal?  @map("db_avg_response_time") @db.Decimal(10,3)

  // Application performance
  apiRequestsPerSecond  Decimal?  @map("api_requests_per_second") @db.Decimal(10,2)
  apiAvgResponseTime    Decimal?  @map("api_avg_response_time") @db.Decimal(10,3)
  apiErrorRate          Decimal?  @map("api_error_rate") @db.Decimal(5,2)
  activeSessions        Int?      @map("active_sessions")

  // Business metrics
  concurrentBookings    Int?      @map("concurrent_bookings")
  searchQueriesPerSecond Decimal? @map("search_queries_per_second") @db.Decimal(10,2)
  paymentSuccessRate    Decimal?  @map("payment_success_rate") @db.Decimal(5,2)

  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("system_performance")
}