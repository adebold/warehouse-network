{
  "name": "skidspace-production-scripts",
  "version": "1.0.0",
  "description": "Production deployment and credential management scripts for Skidspace",
  "private": true,
  "scripts": {
    "generate-credentials": "node generate-super-admin-credentials.js",
    "init-database": "node init-production-database.js",
    "upload-secrets": "node gcp-secret-manager.js upload",
    "list-secrets": "node gcp-secret-manager.js list",
    "create-iam": "node gcp-secret-manager.js iam",
    "deploy-setup": "npm run generate-credentials && npm run upload-secrets && npm run init-database"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "production",
    "deployment",
    "credentials",
    "security",
    "gcp",
    "secret-manager"
  ],
  "author": "Skidspace Team",
  "license": "UNLICENSED"
}