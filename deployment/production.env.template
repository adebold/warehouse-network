# export COOKIE_SECRET=$(gcloud secrets versions access latest --secret=skidspace-prod-cookie-secret --project=${GCP_PROJECT_ID})
# export SESSION_SECRET=$(gcloud secrets versions access latest --secret=skidspace-prod-session-secret --project=${GCP_PROJECT_ID})
# export CSRF_SECRET=$(gcloud secrets versions access latest --secret=skidspace-prod-csrf-secret --project=${GCP_PROJECT_ID})
# export INTERNAL_API_KEY=$(gcloud secrets versions access latest --secret=skidspace-prod-internal-api-key --project=${GCP_PROJECT_ID})
# export WEBHOOK_SECRET=$(gcloud secrets versions access latest --secret=skidspace-prod-webhook-secret --project=${GCP_PROJECT_ID})
# export JWT_SIGNING_KEY=$(gcloud secrets versions access latest --secret=skidspace-prod-jwt-signing-key --project=${GCP_PROJECT_ID})
# export ENCRYPTION_KEY=$(gcloud secrets versions access latest --secret=skidspace-prod-encryption-key --project=${GCP_PROJECT_ID})
#
# ============================================================================