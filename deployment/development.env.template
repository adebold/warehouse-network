# Skidspace Development Environment Configuration
#
# This template is for local development with minimal security for ease of use
# DO NOT USE THESE VALUES IN STAGING OR PRODUCTION
#
# Last updated: 2026-03-24

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Skidspace (Dev)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Version
APP_VERSION="1.0.0-dev"
BUILD_ID="local-dev"

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Local Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skidspace_dev"

# Database Connection Pool (minimal for dev)
DATABASE_POOL_MIN="1"
DATABASE_POOL_MAX="3"

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-dev-secret-not-secure"

# Super Admin Setup (Easy for dev)
SUPER_ADMIN_SETUP_KEY="dev_setup_123"

# Session Security (Minimal for dev)
COOKIE_SECRET="dev-cookie-secret"
SESSION_SECRET="dev-session-secret"
CSRF_SECRET="dev-csrf-secret"

# Cookie Configuration (Relaxed for dev)
COOKIE_DOMAIN="localhost"
SECURE_COOKIES="false"
SAME_SITE_COOKIES="lax"
HTTP_ONLY_COOKIES="false" # Easier for dev tools

# Password Policy (Relaxed for dev)
PASSWORD_MIN_LENGTH="8"
PASSWORD_REQUIRE_UPPERCASE="false"
PASSWORD_REQUIRE_LOWERCASE="false"
PASSWORD_REQUIRE_NUMBERS="false"
PASSWORD_REQUIRE_SYMBOLS="false"

# ============================================================================
# OAUTH PROVIDERS (Development Apps)
# ============================================================================

# Google OAuth (Dev App)
GOOGLE_CLIENT_ID="your-dev-google-client-id"
GOOGLE_CLIENT_SECRET="your-dev-google-client-secret"

# GitHub OAuth (Dev App)
GITHUB_CLIENT_ID="your-dev-github-client-id"
GITHUB_CLIENT_SECRET="your-dev-github-client-secret"

# ============================================================================
# API SECURITY (Minimal for dev)
# ============================================================================

# Internal API Keys (Simple for dev)
INTERNAL_API_KEY="dev_api_key_123"
WEBHOOK_SECRET="dev_webhook_secret"
JWT_SIGNING_KEY="dev_jwt_key"

# Encryption (Simple for dev)
ENCRYPTION_KEY="dev_encryption_key_12345678901234567890123456789012"

# Rate Limiting (Disabled for dev)
API_RATE_LIMIT="99999"
API_RATE_LIMIT_WINDOW="60000"

# ============================================================================
# LOCAL SERVICES
# ============================================================================

# Redis (Local Docker)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# ============================================================================
# EMAIL CONFIGURATION (Local Testing)
# ============================================================================

# SMTP Configuration (Local testing with MailHog)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Email Addresses
FROM_EMAIL="dev@localhost"
SUPPORT_EMAIL="support@localhost"
ADMIN_EMAIL="admin@localhost"

# ============================================================================
# FILE UPLOAD & STORAGE
# ============================================================================

# Upload Configuration (Relaxed for dev)
NEXT_PUBLIC_MAX_FILE_SIZE="52428800" # 50MB for dev testing
ALLOWED_FILE_TYPES="*" # Allow all file types for testing

# Storage Provider (Local only)
UPLOAD_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Image Processing (Disabled for faster dev)
ENABLE_IMAGE_OPTIMIZATION="false"

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Logging Configuration (Verbose for dev)
LOG_LEVEL="debug"
LOG_FORMAT="pretty" # Easier to read in development
LOG_MAX_FILES="3"
LOG_MAX_SIZE="10m"

# Error Tracking (Disabled for dev)
SENTRY_DSN=""

# Health Checks
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_PATH="/api/health"

# ============================================================================
# FEATURE FLAGS (All enabled for testing)
# ============================================================================

# Core Features
ENABLE_ANALYTICS="false"
ENABLE_AUDIT_LOGGING="false" # Disabled for cleaner logs
ENABLE_RATE_LIMITING="false"
ENABLE_2FA="false"
ENABLE_SSO="false"

# Performance Features (Disabled for easier debugging)
ENABLE_CACHING="false"
ENABLE_CDN="false"
ENABLE_COMPRESSION="false"

# Security Features (Minimal for dev)
ENABLE_SECURITY_HEADERS="false"
ENABLE_CSRF_PROTECTION="false"
ENABLE_HELMET="false"

# Experimental Features (All enabled for testing)
ENABLE_BETA_FEATURES="true"
ENABLE_A_B_TESTING="true"

# ============================================================================
# DEVELOPMENT & DEBUGGING (All enabled)
# ============================================================================

# Debug Flags (All enabled for dev)
DEBUG_MODE="true"
ENABLE_DEBUG_ROUTES="true"
ENABLE_DEV_TOOLS="true"
VERBOSE_LOGGING="true"

# Testing Flags (All enabled for dev)
ENABLE_TEST_ROUTES="true"
ENABLE_MOCK_DATA="true"

# Hot Reload
FAST_REFRESH="true"
TURBOPACK="false" # Set to true to test Turbopack

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Database Tools
ENABLE_DB_STUDIO="true" # Enables Prisma Studio
DB_STUDIO_PORT="5555"

# API Documentation
ENABLE_SWAGGER="true"
SWAGGER_PATH="/api/docs"

# GraphQL Playground (if using GraphQL)
ENABLE_GRAPHQL_PLAYGROUND="false"

# ============================================================================
# PERFORMANCE & SCALING (Minimal for dev)
# ============================================================================

# Next.js Configuration
NEXT_RUNTIME_TIMEOUT="0" # No timeout for debugging
NEXT_STATIC_GENERATION_TIMEOUT="0"

# Memory Limits (Minimal for dev)
NODE_OPTIONS="--max-old-space-size=512"

# Clustering (Disabled for dev)
CLUSTER_MODE="false"
CLUSTER_WORKERS="1"

# Cache (Disabled for dev)
CACHE_TTL="0"

# ============================================================================
# NETWORKING & CORS (Completely open for dev)
# ============================================================================

# CORS Configuration (Open for dev)
CORS_ORIGIN="*"
CORS_CREDENTIALS="true"
CORS_MAX_AGE="0" # No caching

# ============================================================================
# CUSTOM APPLICATION SETTINGS
# ============================================================================

# Business Logic (Unlimited for dev)
DEFAULT_ORGANIZATION_TIER="ENTERPRISE"
MAX_WAREHOUSES_PER_ORG="-1" # Unlimited
MAX_USERS_PER_ORG="-1" # Unlimited
MAX_API_CALLS_PER_MONTH="-1" # Unlimited

# UI Configuration
DEFAULT_TIMEZONE="America/New_York" # Developer's timezone
DEFAULT_LOCALE="en-US"
DEFAULT_CURRENCY="USD"

# Notifications (Disabled for dev)
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_PUSH_NOTIFICATIONS="false"

# ============================================================================
# DEVELOPMENT SEED DATA
# ============================================================================

# Auto-create dev data on startup
AUTO_SEED_DATA="true"
SEED_ADMIN_EMAIL="admin@dev.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ORG_NAME="Dev Organization"

# Mock Data Counts
MOCK_USER_COUNT="5"
MOCK_WAREHOUSE_COUNT="3"
MOCK_INVENTORY_COUNT="25"

# ============================================================================
# LOCAL SERVICES PORTS
# ============================================================================

# Application
APP_PORT="3000"

# Database
POSTGRES_PORT="5432"

# Redis
REDIS_PORT="6379"

# MailHog (Email testing)
MAILHOG_SMTP_PORT="1025"
MAILHOG_HTTP_PORT="8025"

# Prisma Studio
PRISMA_STUDIO_PORT="5555"

# ============================================================================
# DEVELOPMENT WORKFLOW
# ============================================================================

# Auto-restart on file changes
WATCH_FILES="true"
WATCH_DIRECTORIES="src,pages,components,lib,prisma"

# Auto-migrate database on startup
AUTO_MIGRATE="true"

# Auto-generate Prisma client
AUTO_GENERATE="true"

# Clear console on restart
CLEAR_CONSOLE="true"

# Open browser on startup
OPEN_BROWSER="false"

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test Database
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/skidspace_test"

# Test Mode
TEST_MODE="false"
RUN_TESTS_ON_STARTUP="false"

# Coverage
COLLECT_COVERAGE="false"

# ============================================================================
# DOCKER DEVELOPMENT
# ============================================================================

# Docker Compose Services
COMPOSE_PROJECT_NAME="skidspace-dev"
COMPOSE_FILE="docker-compose.dev.yml"

# ============================================================================
# ENVIRONMENT VALIDATION
# ============================================================================

# Development environment marker
ENVIRONMENT_TYPE="development"
IS_PRODUCTION="false"
IS_DEVELOPMENT="true"

# Skip certain validations in dev
SKIP_ENV_VALIDATION="false"
SKIP_SSL_VERIFICATION="true"

# ============================================================================
# QUICK SETUP COMMANDS
# ============================================================================
#
# Quick setup for new developers:
#
# 1. Copy this file to .env.local
# 2. Start services: docker-compose up -d
# 3. Migrate database: npm run db:migrate
# 4. Seed data: npm run db:seed
# 5. Start dev server: npm run dev
#
# Access points:
# - App: http://localhost:3000
# - Database: localhost:5432
# - Redis: localhost:6379
# - Email: http://localhost:8025 (MailHog)
# - DB Studio: http://localhost:5555
#
# ============================================================================