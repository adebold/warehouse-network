{
  "name": "@warehouse/ai-platform",
  "version": "1.0.0",
  "description": "Enterprise AI/ML platform for warehouse marketplace intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "train": "tsx src/scripts/train-models.ts",
    "serve:api": "tsx src/api/server.ts",
    "serve:inference": "tsx src/api/inference-server.ts",
    "pipeline:batch": "tsx src/pipelines/batch-processor.ts",
    "pipeline:stream": "tsx src/pipelines/stream-processor.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "scikit-learn": "^0.24.2",
    "pandas": "^2.1.0",
    "numpy": "^1.25.0",
    "fastapi": "^0.104.0",
    "redis": "^5.11.0",
    "kafka-node": "^5.0.0",
    "pg": "^8.11.0",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "winston": "^3.11.0",
    "bull": "^4.12.0",
    "ioredis": "^5.3.0",
    "axios": "^1.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.0",
    "uuid": "^9.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.0",
    "zod": "^3.22.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.13",
    "type-orm": "^0.3.17",
    "@types/node": "^20.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/compression": "^1.7.0",
    "@types/lodash": "^4.14.0",
    "@types/uuid": "^9.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "tsc-alias": "^1.8.8",
    "eslint": "^8.54.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "ml",
    "machine-learning",
    "warehouse",
    "logistics",
    "optimization",
    "prediction",
    "enterprise",
    "real-time"
  ],
  "author": "Warehouse Network Team",
  "license": "MIT"
}