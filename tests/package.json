{
  "name": "@skidspace/testing",
  "version": "1.0.0",
  "description": "Comprehensive testing suite for Skidspace authentication and SaaS system",
  "private": true,
  "scripts": {
    "test": "jest --config=./config/jest.config.js",
    "test:watch": "jest --config=./config/jest.config.js --watch",
    "test:coverage": "jest --config=./config/jest.config.js --coverage",
    "test:coverage:report": "jest --config=./config/jest.config.js --coverage --coverageReporters=html",
    "test:unit": "jest --config=./config/jest.config.js unit/",
    "test:unit:auth": "jest --config=./config/jest.config.js unit/auth/",
    "test:unit:security": "jest --config=./config/jest.config.js unit/security/",
    "test:integration": "jest --config=./config/jest.config.js integration/",
    "test:integration:rbac": "jest --config=./config/jest.config.js integration/auth/rbac-permissions.test.ts",
    "test:integration:tenant": "jest --config=./config/jest.config.js integration/multi-tenant-isolation.test.ts",
    "test:security": "jest --config=./config/jest.config.js security/",
    "test:security:owasp": "jest --config=./config/jest.config.js security/ --testNamePattern=\"OWASP\"",
    "test:e2e": "playwright test --config=./config/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=./config/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=./config/playwright.config.ts --debug",
    "test:db:reset": "npx prisma db push --force-reset --accept-data-loss",
    "test:db:seed": "npx tsx utils/seed-test-data.ts",
    "test:performance": "k6 run performance/auth-load-test.js",
    "test:lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test:type-check": "tsc --noEmit",
    "test:all": "npm run test:lint && npm run test:type-check && npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "clean": "rm -rf coverage/ test-results/ playwright-report/",
    "setup": "npm run test:db:reset && npm run test:db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.15",
    "otplib": "^12.0.1",
    "prisma": "^5.10.0",
    "zod": "^3.22.4"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["<rootDir>/unit/**/*.test.(js|ts)"]
      },
      {
        "displayName": "integration",
        "testMatch": ["<rootDir>/integration/**/*.test.(js|ts)"]
      },
      {
        "displayName": "security",
        "testMatch": ["<rootDir>/security/**/*.test.(js|ts)"]
      }
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}